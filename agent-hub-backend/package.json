{
  "name": "agent-hub-backend",
  "version": "1.0.0",
  "description": "AgentHub API Gateway - REST API for agent execution and management",
  "main": "dist/server.js",
  "scripts": {
    "start": "cross-env PORT=3002 node dist/reliable-server.js",
    "start:prod": "cross-env NODE_ENV=production PORT=8080 node dist/production-server.js",
    "dev": "nodemon src/server.ts",
    "dev:prod": "cross-env NODE_ENV=production nodemon src/production-server.ts",
    "dev:old": "cross-env PORT=3002 nodemon src/server.ts",
    "simple": "cross-env PORT=3002 nodemon src/simple-server.ts",
    "start:win": "set PORT=3002 && node dist/reliable-server.js",
    "dev:win": "set PORT=3002 && nodemon src/reliable-server.ts",
    "build": "tsc",
    "build:prod": "tsc && npm run copy:bedrock",
    "build:lambda": "tsc && npm run copy:bedrock && npm run create:lambda-handler",
    "start-all": "node start-intelligence.js",
    "start-with-ui": "concurrently \"npm run dev\" \"cd ../agent-hub-ui && npm start\"",
    "setup:aws:costs": "node ../setup-aws-costs.js",
    "create:lambda-handler": "echo const app = require('./lambda-production-server'); > dist/lambda-handler.js && echo. >> dist/lambda-handler.js && echo const serverless = require('serverless-http'); >> dist/lambda-handler.js && echo exports.handler = serverless(app); >> dist/lambda-handler.js",
    "copy:bedrock": "xcopy /E /I /Y ..\\bedrock-integration .\\dist\\bedrock-integration\\",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": [
    "api",
    "gateway",
    "agents",
    "ai",
    "automation"
  ],
  "author": "AgentHub Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.939.0",
    "@aws-sdk/client-bedrock-runtime": "^3.926.0",
    "@aws-sdk/client-cost-explorer": "^3.925.0",
    "@aws-sdk/client-s3": "^3.937.0",
    "@aws-sdk/credential-providers": "^3.925.0",
    "@types/archiver": "^7.0.0",
    "@types/multer": "^2.0.0",
    "archiver": "^7.0.1",
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.6.10",
    "serverless-http": "^3.2.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6",
    "string-similarity": "^4.0.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/sqlite3": "^3.1.11",
    "@types/supertest": "^2.0.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
