# AgentHub Platform DNS Configuration
# Copy to .env to use custom DNS setup

# Environment Mode
NODE_ENV=local
AGENTHUB_MODE=hybrid

# Custom DNS Configuration
CUSTOM_DOMAIN=agenthub.local
UI_HOST=agenthub.local
API_HOST=api.agenthub.local
UI_PORT=3001
API_PORT=3002

# Service URLs
REACT_APP_API_URL=http://api.agenthub.local:3002
REACT_APP_UI_URL=http://agenthub.local:3001

# AWS Integration (for hybrid mode)
AWS_REGION=us-east-1
ENABLE_REAL_COST_TRACKING=true
ENABLE_BEDROCK=true
ENABLE_S3=true
ENABLE_CLOUDWATCH=true

# Local Services (keep these local)
USE_LOCAL_DYNAMODB=true
USE_LOCAL_LAMBDA=true
USE_LOCAL_MCP=true

# SSL Configuration (optional)
ENABLE_HTTPS=false
SSL_CERT_PATH=./certs/agenthub.local.crt
SSL_KEY_PATH=./certs/agenthub.local.key

# CORS Configuration
CORS_ORIGIN=http://agenthub.local:3001,http://dashboard.agenthub.local:3001

# Debug
DEBUG=agenthub:*
VERBOSE_LOGGING=true