{
  "name": "agent-hub-infrastructure",
  "version": "1.0.0",
  "description": "AWS CDK Infrastructure for Agent Hub Platform",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:unit": "jest --testPathPattern=test --testPathIgnorePatterns=integration",
    "test:integration": "jest --testPathPattern=integration --testTimeout=120000",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cdk": "cdk",
    "deploy": "node deploy-poc.js",
    "deploy:direct": "cdk deploy --all",
    "destroy": "cdk destroy --all --force",
    "diff": "cdk diff",
    "synth": "cdk synth",
    "validate": "node test/deployment-validation.js"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.100.0",
    "constructs": "^10.3.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.922.0",
    "@aws-sdk/client-cloudwatch": "^3.922.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.922.0",
    "@aws-sdk/client-ecs": "^3.923.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.922.0",
    "@aws-sdk/client-sns": "^3.922.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.13",
    "aws-cdk": "^2.100.0",
    "jest": "^29.5.0",
    "node-fetch": "^2.7.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.0.0"
  }
}
