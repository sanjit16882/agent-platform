{
  "name": "aws-native-agent-hub",
  "version": "1.0.0",
  "description": "AWS Native Agent Hub Platform - Unified Local/AWS Architecture",
  "main": "unified-api-server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=local node unified-api-server.js",
    "dev:local": "NODE_ENV=local npm run dev",
    "dev:aws": "NODE_ENV=production npm run dev",
    "start": "node unified-api-server.js",
    "build": "npm run build:infra && npm run build:frontend",
    "build:infra": "cd infrastructure && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "deploy:local": "echo 'Starting local development...' && npm run dev:local",
    "deploy:aws": "./deployment/deploy-unified.sh",
    "deploy:complete": "node deploy-complete.js",
    "deploy:mcp": "node mcp-servers/build-and-push.js && node mcp-servers/deploy-services.js",
    "cleanup": "node cleanup-complete.js",
    "test": "jest",
    "test:local": "NODE_ENV=local npm test",
    "test:aws": "NODE_ENV=production npm test",
    "test:mcp": "cd mcp-servers && node demo-test.js",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx",
    "clean": "rm -rf */node_modules */dist */build */.aws-sam",
    "setup": "./setup-unified-dev.sh",
    "demo": "./deployment/deploy-demo.sh"
  },
  "keywords": [
    "aws",
    "serverless",
    "agent-hub",
    "unified-architecture",
    "local-development",
    "cost-optimized"
  ],
  "author": "Agent Hub Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@aws-sdk/lib-dynamodb": "^3.922.0",
    "aws-sdk": "^2.1400.0",
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
