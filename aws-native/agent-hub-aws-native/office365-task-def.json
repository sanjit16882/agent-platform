{
  "family": "agent-hub-mcp-office365-dev",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::448049831733:role/MCPInfrastructureStack-dev-TaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::448049831733:role/MCPInfrastructureStack-dev-TaskRole",
  "containerDefinitions": [
    {
      "name": "mcp-office365",
      "image": "448049831733.dkr.ecr.us-east-1.amazonaws.com/agent-hub-mcp-office365-dev:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "LOG_LEVEL",
          "value": "info"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/mcp-office365",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}