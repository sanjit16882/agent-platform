# Server Configuration
PORT=3001
NODE_ENV=development
API_VERSION=v1

# Database Configuration (extend existing or add new)
DATABASE_URL=sqlite:./data/agenthub.db

# Redis Configuration (for rate limiting and caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# API Key Configuration
API_KEY_LENGTH=32
API_KEY_PREFIX=ak_

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Webhook Configuration
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=5

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Security
BCRYPT_ROUNDS=12
API_KEY_HASH_ROUNDS=10

# Frontend Integration
FRONTEND_URL=http://localhost:3000

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# S3 Agent Storage
S3_AGENTS_BUCKET=agenthub-agents-storage

# ============================================
# Agent Testing Framework Configuration
# ============================================

# Feature Flags
TESTING_FEATURE_ENABLED=true
TESTING_ROLLOUT_PERCENTAGE=100
TESTING_ALLOWED_USERS=
TESTING_ALLOWED_ENVIRONMENTS=development,staging,production

# Test Execution Settings
TESTING_DEFAULT_TIMEOUT=30000
TESTING_MAX_TIMEOUT=300000
TESTING_DEFAULT_RETRIES=0
TESTING_MAX_RETRIES=3
TESTING_MAX_CONCURRENT=10
TESTING_ENABLE_PARALLEL=true
TESTING_DEFAULT_MODE=demo

# Mock Layer Settings
TESTING_MOCK_ENABLED=true
TESTING_MOCKS_DIR=./mocks
TESTING_MOCK_MIN_LATENCY=100
TESTING_MOCK_MAX_LATENCY=500
TESTING_MOCK_HOT_RELOAD=false

# Evaluation Settings
TESTING_DEFAULT_TOLERANCE=0.8
TESTING_ENABLE_AI_METRICS=false
TESTING_TOKEN_METHOD=simple
TESTING_COST_INPUT_TOKEN=0.00001
TESTING_COST_OUTPUT_TOKEN=0.00003

# Storage Settings
TESTING_RETENTION_DAYS=90
TESTING_METRICS_RETENTION_DAYS=730
TESTING_ENABLE_CACHING=true
TESTING_CACHE_TTL=300

# Analytics Settings
TESTING_ANALYTICS_ENABLED=true
TESTING_AGGREGATION_INTERVAL=60
TESTING_ENABLE_REALTIME=false

# Insights & Recommendations
TESTING_INSIGHTS_ENABLED=true
TESTING_MIN_FAILURE_COUNT=5
TESTING_MIN_PATTERN_OCCURRENCES=3
TESTING_ENABLE_AUTO_HEALING=false

# Sandbox Settings
TESTING_SANDBOX_ENABLED=true
TESTING_SANDBOX_ISOLATE=true
TESTING_SANDBOX_CONFIG=./config/sandbox.config.json

# Logging Settings
TESTING_LOG_LEVEL=info
TESTING_DETAILED_LOGS=false
TESTING_LOG_TO_FILE=false
TESTING_LOG_FILE=./logs/testing.log

# Health Check Settings
TESTING_HEALTH_INTERVAL=30
TESTING_DB_TIMEOUT=5000

# ============================================
# Vector DB Configuration (NEW)
# ============================================

# Provider Selection
VECTOR_DB_PROVIDER=mock  # Options: opensearch, pinecone, pgvector, mock

# OpenSearch Configuration
OPENSEARCH_ENDPOINT=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Pinecone Configuration
PINECONE_ENDPOINT=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# Pgvector Configuration (PostgreSQL)
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=agenthub
PGVECTOR_USER=
PGVECTOR_PASSWORD=

# Performance Settings
VECTOR_DB_TIMEOUT=30000
VECTOR_DB_MAX_RETRIES=3
VECTOR_DB_RETRY_DELAY=1000

# Caching Settings
VECTOR_DB_ENABLE_CACHE=true
VECTOR_DB_MAX_CACHE_SIZE=1000

# Cost Tracking
EMBEDDING_COST_PER_1M=0.0001  # Cost per 1M tokens for embeddings
SEARCH_COST_PER_1K=0.0001     # Cost per 1K searches

# Limits
MAX_DOCUMENTS_PER_SEARCH=20
MAX_BATCH_SIZE=100

# Embedding Model
EMBEDDING_MODEL=amazon.titan-embed-text-v1
EMBEDDING_DIMENSION=1536
