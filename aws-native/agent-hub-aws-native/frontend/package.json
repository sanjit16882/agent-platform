{
  "name": "aws-native-agent-hub-frontend",
  "version": "1.0.0",
  "description": "React Frontend for AWS Native Agent Hub Platform",
  "private": true,
  "dependencies": {
    "@aws-amplify/ui-react": "^6.0.0",
    "aws-amplify": "^6.0.0",
    "react": "^18.2.0",
