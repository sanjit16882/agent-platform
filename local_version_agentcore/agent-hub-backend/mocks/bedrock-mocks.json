        "latency_ms": 150
      }
    },
    {
      "id": "bedrock-test-connection",
      "service": "bedrock",
      "endpoint": "/api/testing/bedrock/test-connection",
      "method": "POST",
      "response": {
        "status": 200,
        "body": {
          "connected": true,
