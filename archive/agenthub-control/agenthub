#!/usr/bin/env python3
"""
AgentHub Production Control Tool
Simple command to start/stop your production AgentHub instance

Usage:
  agenthub start [duration]  - Start instance (default 30 minutes)
  agenthub stop             - Stop instance immediately
  agenthub status           - Check instance status
  agenthub config           - Configure instance ID and region
  agenthub url              - Get current API URL
"""

import boto3
import sys
import time
import json
import os
from pathlib import Path

CONFIG_FILE = Path.home() / '.agenthub' / 'config.json'

class AgentHubControl:
    def __init__(self):
        self.config = self.load_config()
        self.ec2 = boto3.client('ec2', region_name=self.config.get('region', 'us-east-1'))
        
    def load_config(self):
        """Load configuration from file"""
        if CONFIG_FILE.exists():
            with open(CONFIG_FILE, 'r') as f:
                return json.load(f)
        return {}
    
    def save_config(self, config):
        """Save configuration to file"""
        CONFIG_FILE.parent.mkdir(exist_ok=True)
        with open(CONFIG_FILE, 'w') as f:
            json.dump(config, f, indent=2)
    
    def configure(self):
        """Interactive configuration setup"""
        print("🔧 AgentHub Configuration Setup")
        print("=" * 40)
        
        instance_id = input(f"EC2 Instance ID [{self.config.get('instance_id', '')}]: ").strip()
        if instance_id:
            self.config['instance_id'] = instance_id
        
        region = input(f"AWS Region [{self.config.get('region', 'us-east-1')}]: ").strip()
        if region:
            self.config['region'] = region
        
        self.save_config(self.config)
        print("✅ Configuration saved!")
        
    def get_instance_id(self):
        """Get instance ID from config"""
        instance_id = self.config.get('instance_id')
        if not instance_id:
            print("❌ Instance ID not configured. Run: agenthub config")
            sys.exit(1)
        return instance_id
    
    def start(self, duration=30):
        """Start the AgentHub instance"""
        instance_id = self.get_instance_id()
        
        print(f"🚀 Starting AgentHub instance {instance_id}...")
        
        try:
            # Start instance
            self.ec2.start_instances(InstanceIds=[instance_id])
            print("⏳ Waiting for instance to start...")
            
            # Wait for running state
            waiter = self.ec2.get_waiter('instance_running')
            waiter.wait(InstanceIds=[instance_id])
            
            # Get public IP
            response = self.ec2.describe_instances(InstanceIds=[instance_id])
            instance = response['Reservations'][0]['Instances'][0]
            public_ip = instance.get('PublicIpAddress')
            
            if public_ip:
                api_url = f"http://{public_ip}"
                print(f"✅ AgentHub started successfully!")
                print(f"🌐 API URL: {api_url}")
                print(f"⏰ Auto-stop in {duration} minutes")
                print()
                print("📋 Configure your tools:")
                print(f"   CLI: agent config set --api-url {api_url}")
                print(f"   VS Code: Use {api_url} in AgentHub settings")
                
                # Save current URL
                self.config['current_url'] = api_url
                self.save_config(self.config)
                
                # Schedule auto-stop if duration specified
                if duration > 0:
                    print(f"\n⏰ Scheduling auto-stop in {duration} minutes...")
                    self.schedule_stop(duration)
                
            else:
                print("❌ Could not get public IP address")
                
        except Exception as e:
            print(f"❌ Error starting instance: {e}")
            sys.exit(1)
    
    def stop(self):
        """Stop the AgentHub instance"""
        instance_id = self.get_instance_id()
        
        print(f"⏹️ Stopping AgentHub instance {instance_id}...")
        
        try:
            self.ec2.stop_instances(InstanceIds=[instance_id])
            print("⏳ Waiting for instance to stop...")
            
            # Wait for stopped state
            waiter = self.ec2.get_waiter('instance_stopped')
            waiter.wait(InstanceIds=[instance_id])
            
            print("✅ AgentHub stopped successfully!")
            print("💰 No compute charges while stopped")
            
            # Clear current URL
            if 'current_url' in self.config:
                del self.config['current_url']
                self.save_config(self.config)
                
        except Exception as e:
            print(f"❌ Error stopping instance: {e}")
            sys.exit(1)
    
    def status(self):
        """Check instance status"""
        instance_id = self.get_instance_id()
        
        try:
            response = self.ec2.describe_instances(InstanceIds=[instance_id])
            instance = response['Reservations'][0]['Instances'][0]
            
            state = instance['State']['Name']
            instance_type = instance['InstanceType']
            public_ip = instance.get('PublicIpAddress', 'N/A')
            
            print(f"📊 AgentHub Status")
            print(f"=" * 30)
            print(f"Instance ID: {instance_id}")
            print(f"State: {state}")
            print(f"Type: {instance_type}")
            print(f"Public IP: {public_ip}")
            
            if state == 'running' and public_ip != 'N/A':
                api_url = f"http://{public_ip}"
                print(f"API URL: {api_url}")
                
                # Test API health
                try:
                    import requests
                    response = requests.get(f"{api_url}/api/health", timeout=5)
                    if response.status_code == 200:
                        print("API Status: ✅ Healthy")
                    else:
                        print("API Status: ⚠️ Not responding")
                except:
                    print("API Status: ⏳ Starting up...")
            
        except Exception as e:
            print(f"❌ Error checking status: {e}")
            sys.exit(1)
    
    def get_url(self):
        """Get current API URL"""
        current_url = self.config.get('current_url')
        if current_url:
            print(current_url)
        else:
            print("❌ No active AgentHub instance. Run: agenthub start")
            sys.exit(1)
    
    def schedule_stop(self, duration):
        """Schedule auto-stop using background process"""
        import threading
        
        def auto_stop():
            time.sleep(duration * 60)
            print(f"\n⏰ Auto-stopping after {duration} minutes...")
            self.stop()
        
        thread = threading.Thread(target=auto_stop, daemon=True)
        thread.start()

def main():
    if len(sys.argv) < 2:
        print("AgentHub Production Control")
        print("=" * 30)
        print("Usage:")
        print("  agenthub start [duration]  - Start instance (default 30 min)")
        print("  agenthub stop             - Stop instance")
        print("  agenthub status           - Check status")
        print("  agenthub config           - Configure settings")
        print("  agenthub url              - Get API URL")
        print()
        print("Examples:")
        print("  agenthub start            - Start for 30 minutes")
        print("  agenthub start 60         - Start for 60 minutes")
        print("  agenthub start 0          - Start without auto-stop")
        sys.exit(1)
    
    control = AgentHubControl()
    command = sys.argv[1].lower()
    
    if command == 'start':
        duration = 30  # Default 30 minutes
        if len(sys.argv) > 2:
            try:
                duration = int(sys.argv[2])
            except ValueError:
                print("❌ Duration must be a number (minutes)")
                sys.exit(1)
        control.start(duration)
        
    elif command == 'stop':
        control.stop()
        
    elif command == 'status':
        control.status()
        
    elif command == 'config':
        control.configure()
        
    elif command == 'url':
        control.get_url()
        
    else:
        print(f"❌ Unknown command: {command}")
        sys.exit(1)

if __name__ == '__main__':
    main()